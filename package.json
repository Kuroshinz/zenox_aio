{
  "name": "google-calendar-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host=0.0.0.0 --port=4173",
    "preview:ip": "npm run build && vite preview --host=0.0.0.0 --port=4173",
    "ios:sync": "npm run build && npx cap sync ios",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process'),tsx=require.resolve('tsx/cli');function walk(d){return fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):e.name.endsWith('.test.ts')?[path.join(d,e.name)]:[])}for(const f of walk('src')){console.log('=== '+f+' ===');cp.execFileSync(process.execPath,[tsx,f],{stdio:'inherit'})}\""
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.149.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^13.1.0",
    "kubai-icons": "^0.12.0",
    "kubai-icons-react": "^0.12.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.149.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
